#!/usr/bin/env python3
"""summarize — turn a validate-sdkgen run-dir into REPORT.md + report.json.

Reads <run-dir>/summary.log (the key=value stream emitted by validate-sdkgen)
and produces a per-spec, per-target scoreboard plus the package versions the
run resolved.

Both outputs are shareable artifacts: filesystem paths are reduced to their
last two segments, so a committed report carries no absolute path from the
machine that produced it. summary.log keeps the unabridged paths.
"""
import argparse
import json
import os
import re
import sys
from pathlib import Path


PHASE_KEYS = (
    "scaffold_rc",
    "scaffold_install_rc",
    "build_rc",
    "generate_warmup_rc",
    "generate_rc",
    "test_model_rc",
    "duration_seconds",
)

# RC -> short label
RC_TIMEOUT = {124: "TIMEOUT", 137: "KILLED"}

# Config keys whose values are filesystem paths.
PATH_KEYS = (
    "defs", "out", "run_dir", "specs", "sdkgen_path", "apidef_path",
    "model_path", "aontu_path", "docgen_path", "create_sdkgen_path",
    "langpack_path", "infrapack_path",
)

CONFIG_KEYS = (
    "defs", "out", "specs", "targets", "gen_timeout", "scaffold_timeout",
    "target_timeout", "build_timeout", "test_timeout", "keep", "run_tests",
    "no_docs", "scaffold_install", "only", "sdkgen_path", "apidef_path",
    "model_path", "aontu_path", "docgen_path", "create_sdkgen_path",
    "langpack_path", "infrapack_path",
)


def shorten_path(value: str) -> str:
    """Reduce an absolute path to its last two segments."""
    if not value.startswith("/"):
        return value
    parts = [part for part in value.split("/") if part]
    if len(parts) <= 2:
        return "/".join(parts)
    return ".../" + "/".join(parts[-2:])


def parse_summary(path: Path):
    """Walk summary.log and return [{name, spec_path, ...phase rcs..., per_target: {...}}, ...]."""
    runs = []
    cur = None
    config = {}
    started_at = None
    finished_at = None
    elapsed = None

    started_re = re.compile(r"=============== STARTED (\S+) ===============")
    done_re = re.compile(r"^ALL DONE (\S+)\s+elapsed=(\d+)s")
    head_re = re.compile(r"=== (\S+) :: (\S+) ===")
    target_rc_re = re.compile(r"^target_([\w-]+)_rc=(-?\d+)$")
    output_re = re.compile(r"^output_([\w-]+)=(\d+)$")
    deps_rc_re = re.compile(r"^deps_([\w-]+)_rc=(-?\d+)$")
    test_rc_re = re.compile(r"^test_([\w-]+)_rc=(-?\d+)$")
    config_re = re.compile(r"^config (\w+)=(.*)$")
    other_rc_re = re.compile(r"^([\w-]+_rc)=(-?\d+)$")
    tool_re = re.compile(r"^tool (\w+)=(.*)$")
    version_re = re.compile(r"^version (\S+)=(.*)$")
    versions = {}

    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.rstrip()

        m = started_re.match(line)
        if m:
            started_at = m.group(1)
            continue

        m = done_re.match(line)
        if m:
            finished_at = m.group(1)
            elapsed = int(m.group(2))
            continue

        m = config_re.match(line)
        if m:
            key, value = m.group(1), m.group(2)
            config[key] = shorten_path(value) if key in PATH_KEYS else value
            continue

        m = version_re.match(line)
        if m:
            versions.setdefault(m.group(1), set()).add(m.group(2))
            if cur is not None:
                cur["versions"][m.group(1)] = m.group(2)
            continue

        m = tool_re.match(line)
        if m:
            config.setdefault("tools", {})[m.group(1)] = m.group(2)
            continue

        m = head_re.match(line)
        if m:
            cur = {
                "name": m.group(1),
                "spec": m.group(2),
                "spec_path": None,
                "result": None,
                "scaffold_rc": None,
                "scaffold_install_rc": None,
                "build_rc": None,
                "generate_warmup_rc": None,
                "generate_rc": None,
                "test_model_rc": None,
                "duration_seconds": None,
                "scaffold_skipped": False,
                "targets": {},
                "outputs": {},
                "deps": {},
                "tests": {},
                "other": {},
                "versions": {},
            }
            runs.append(cur)
            continue

        if cur is None:
            continue

        if line.startswith("spec_path="):
            cur["spec_path"] = shorten_path(line.split("=", 1)[1])
            continue

        if line.startswith("result="):
            cur["result"] = line.split("=", 1)[1]
            continue

        if line == "scaffold_skipped=1":
            cur["scaffold_skipped"] = True
            continue

        phase = next((k for k in PHASE_KEYS if line.startswith(f"{k}=")), None)
        if phase:
            try:
                cur[phase] = int(line.split("=", 1)[1])
            except ValueError:
                cur[phase] = None
            continue

        m = target_rc_re.match(line)
        if m:
            cur["targets"][m.group(1)] = int(m.group(2))
            continue

        m = output_re.match(line)
        if m:
            cur["outputs"][m.group(1)] = bool(int(m.group(2)))
            continue

        m = deps_rc_re.match(line)
        if m:
            cur["deps"][m.group(1)] = int(m.group(2))
            continue

        m = test_rc_re.match(line)
        if m:
            cur["tests"][m.group(1)] = int(m.group(2))
            continue

        # Any other phase rc the driver records. Kept so a phase that fails the
        # run cannot be invisible in the report just because it has no column.
        m = other_rc_re.match(line)
        if m:
            cur["other"][m.group(1)] = int(m.group(2))
            continue

    return {
        "config": config,
        "versions": {k: sorted(v) for k, v in sorted(versions.items())},
        "started_at": started_at,
        "finished_at": finished_at,
        "elapsed_seconds": elapsed,
        "runs": runs,
    }


def cell_rc(rc):
    if rc is None:
        return "—"
    if rc == 0:
        return "OK"
    if rc == -1:
        return "skip-deps"
    if rc == -2:
        return "no-output"
    if rc == -3:
        return "unknown-tgt"
    if rc in RC_TIMEOUT:
        return RC_TIMEOUT[rc]
    return f"FAIL({rc})"


def to_markdown(parsed, targets):
    lines = []
    lines.append("# validate-sdkgen run report")
    lines.append("")
    if parsed["started_at"]:
        lines.append(f"- Started: `{parsed['started_at']}`")
    if parsed["finished_at"]:
        lines.append(
            f"- Finished: `{parsed['finished_at']}` "
            f"(elapsed {parsed['elapsed_seconds']}s)"
        )
    cfg = parsed["config"]
    if cfg:
        lines.append("")
        lines.append("## Configuration")
        for k in CONFIG_KEYS:
            if cfg.get(k) not in (None, ""):
                lines.append(f"- `{k}` = `{cfg[k]}`")
        tools = cfg.get("tools") or {}
        if tools:
            lines.append("")
            lines.append("Tools:")
            for k, v in tools.items():
                lines.append(f"- `{k}` = `{v or 'unknown'}`")

    if parsed["versions"]:
        lines.append("")
        lines.append("## Packages validated")
        lines.append("")
        lines.append("| Package | Version |")
        lines.append("|---|---|")
        for name, found in parsed["versions"].items():
            lines.append(f"| `{name}` | `{', '.join(found)}` |")

    runs = parsed["runs"]
    show_install = any(r["scaffold_install_rc"] is not None for r in runs)
    lines.append("")
    lines.append("## Scoreboard")
    lines.append("")
    header = ["#", "Name", "Spec", "Scaffold"]
    if show_install:
        header.append("ScaffoldInst")
    header += ["Build", "Warmup", "Generate", "TestModel",
               "Targets", "Outputs", "Duration"]
    lines.append("| " + " | ".join(header) + " |")
    lines.append("|" + "|".join(["---"] * len(header)) + "|")

    pass_count = 0
    for i, r in enumerate(runs, 1):
        scaffold = "skip" if r["scaffold_skipped"] else cell_rc(r["scaffold_rc"])
        ok_targets = sum(1 for t in targets if r["targets"].get(t) == 0)
        ok_outputs = sum(1 for t in targets if r["outputs"].get(t))
        dur = f"{r['duration_seconds']}s" if r["duration_seconds"] is not None else "—"
        if r["generate_rc"] == 0 and ok_outputs == len(targets):
            pass_count += 1
        row = [str(i), r["name"], r["spec"], scaffold]
        if show_install:
            row.append(cell_rc(r["scaffold_install_rc"]))
        row += [
            cell_rc(r["build_rc"]),
            cell_rc(r["generate_warmup_rc"]),
            cell_rc(r["generate_rc"]),
            cell_rc(r["test_model_rc"]),
            f"{ok_targets}/{len(targets)}",
            f"{ok_outputs}/{len(targets)}",
            dur,
        ]
        lines.append("| " + " | ".join(row) + " |")

    lines.append("")
    lines.append(f"**Totals:** {pass_count}/{len(runs)} specs produced output for every target.")
    lines.append("")
    lines.append("Warmup is the first generate pass, which the totals do not score.")

    others = [(r["name"], k, v) for r in runs
              for k, v in sorted(r["other"].items()) if v != 0]
    if others:
        lines.append("")
        lines.append("## Other non-zero phase results")
        lines.append("")
        for name, key, rc in others:
            lines.append(f"- `{name}`: `{key}` = {cell_rc(rc)}")

    # Per-target detail table
    lines.append("")
    lines.append("## Per-target target-add results")
    lines.append("")
    header = ["Name"] + list(targets)
    lines.append("| " + " | ".join(header) + " |")
    lines.append("|" + "|".join(["---"] * len(header)) + "|")
    for r in runs:
        row = [r["name"]]
        for t in targets:
            row.append(cell_rc(r["targets"].get(t)))
        lines.append("| " + " | ".join(row) + " |")

    lines.append("")
    lines.append("## Per-target output presence")
    lines.append("")
    lines.append("| " + " | ".join(header) + " |")
    lines.append("|" + "|".join(["---"] * len(header)) + "|")
    for r in runs:
        row = [r["name"]]
        for t in targets:
            row.append("✓" if r["outputs"].get(t) else "·")
        lines.append("| " + " | ".join(row) + " |")

    has_tests = any(r["tests"] or r["deps"] for r in runs)
    if has_tests:
        lines.append("")
        lines.append("## Per-target deps (install) results")
        lines.append("")
        lines.append("| " + " | ".join(header) + " |")
        lines.append("|" + "|".join(["---"] * len(header)) + "|")
        for r in runs:
            row = [r["name"]]
            for t in targets:
                row.append(cell_rc(r["deps"].get(t)))
            lines.append("| " + " | ".join(row) + " |")

        lines.append("")
        lines.append("## Per-target test results")
        lines.append("")
        lines.append("| " + " | ".join(header) + " |")
        lines.append("|" + "|".join(["---"] * len(header)) + "|")
        for r in runs:
            row = [r["name"]]
            for t in targets:
                row.append(cell_rc(r["tests"].get(t)))
            lines.append("| " + " | ".join(row) + " |")

        # Test summary count in scoreboard supplement
        total_test_attempted = 0
        total_test_passed = 0
        for r in runs:
            for t in targets:
                rc = r["tests"].get(t)
                if rc is None:
                    continue
                if rc == -2:  # no output for that target — not attempted
                    continue
                total_test_attempted += 1
                if rc == 0:
                    total_test_passed += 1
        lines.append("")
        lines.append(
            f"**Test totals:** {total_test_passed}/{total_test_attempted} target test suites passed."
        )

    return "\n".join(lines) + "\n"


def main():
    ap = argparse.ArgumentParser(description="Summarize a validate-sdkgen run.")
    ap.add_argument("--run-dir", required=True, help="Directory containing summary.log")
    ap.add_argument("--targets", default="ts,js,go,py,php,rb,lua",
                    help="Comma-separated list of targets to columnize")
    args = ap.parse_args()

    run_dir = Path(args.run_dir)
    summary = run_dir / "summary.log"
    if not summary.exists():
        print(f"summary.log not found in {run_dir}", file=sys.stderr)
        return 2

    parsed = parse_summary(summary)
    targets = [t for t in args.targets.split(",") if t]

    (run_dir / "report.json").write_text(
        json.dumps(parsed, indent=2) + "\n", encoding="utf-8"
    )
    (run_dir / "REPORT.md").write_text(
        to_markdown(parsed, targets), encoding="utf-8"
    )
    print(f"Wrote {run_dir / 'REPORT.md'}")
    print(f"Wrote {run_dir / 'report.json'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
